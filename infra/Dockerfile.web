# The Next.js studio: the consultation, the API routes and the camera try-on.
#
# Deliberately not a `standalone` build. The app is a pnpm workspace with two local packages and a
# native dependency (sharp); tracing that into a standalone bundle is the kind of thing that fails
# only in production. The image is larger and the wiring is the same one the tests run against.
FROM node:22-slim AS deps

# Must match the pnpm that wrote pnpm-lock.yaml. A different major refuses the lockfile under
# --frozen-lockfile, which is a build failure rather than a silent drift, but a failure all the same.
RUN corepack enable && corepack prepare pnpm@12.4.2 --activate
WORKDIR /repo

# Manifests first, so a dependency change is the only thing that busts this layer.
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY contracts/package.json contracts/
COPY packages/consultation/package.json packages/consultation/
COPY apps/web/package.json apps/web/
RUN pnpm install --frozen-lockfile

FROM deps AS build
COPY . .
# The schemas are generated from contracts/schemas; a stale copy here would be a silent contract
# mismatch, so they are regenerated rather than trusted.
RUN pnpm --filter @tattoo/contracts generate \
    && pnpm --filter web build

FROM build AS run
ENV NODE_ENV=production
ENV PORT=3000
EXPOSE 3000
WORKDIR /repo/apps/web
CMD ["pnpm", "start"]
