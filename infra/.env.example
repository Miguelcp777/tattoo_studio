# Copy to infra/.env on the VM and fill in. This file is a template and holds no secrets.
# infra/.env is gitignored and must stay that way: it holds every credential the studio has.

# ---------------------------------------------------------------------------
# Host and certificate
# ---------------------------------------------------------------------------
# The hostname the studio answers on. Its DNS record does not need to be public, but the DNS API
# below must be able to write the ACME challenge record for it.
TATTOO_DOMAIN=tatuajes.ejemplo.com
ACME_EMAIL=tu-correo@ejemplo.com

# DNS-01 challenge, so no inbound port has to be open for certificate issuance.
# CADDY_DNS_PROVIDER is the Caddyfile directive name; CADDY_DNS_MODULE is the plugin compiled in.
# Cloudflare shown; for another registrar use its caddy-dns module and matching directive.
CADDY_DNS_MODULE=github.com/caddy-dns/cloudflare
CADDY_DNS_PROVIDER=cloudflare
CADDY_DNS_TOKEN=

# ---------------------------------------------------------------------------
# Studio secrets. Generate with: openssl rand -hex 32
# ---------------------------------------------------------------------------
# Shared between the web app and the worker; the worker rejects any other caller.
TATTOO_WORKER_TOKEN=

# Encrypts the media store at rest. CHANGING THIS MAKES EVERY STORED DESIGN AND PHOTO UNREADABLE.
# Generate once, back it up, never rotate it casually.
TATTOO_MEDIA_KEY=

# ---------------------------------------------------------------------------
# Model providers
# ---------------------------------------------------------------------------
# Artwork, reference analysis, moderation and the mockup finish.
OPENAI_API_KEY=

# FLUX.2, used only for the generated skin plates (ADR-0009). Leave TATTOO_IMAGE_BACKEND=openai
# to run without it.
TATTOO_IMAGE_BACKEND=bfl
BFL_API_KEY=

# The consultation agent runs inside the web app, so this is read there.
# Unset it to fall back to the deterministic keyword path with no model calls.
TATTOO_CONSULTATION_BACKEND=claude
ANTHROPIC_API_KEY=

# The Sonnet scout that plans reference searches and judges the images found. Optional.
TATTOO_SCOUT_PLANNER=claude
