# The variables the studio needs. On the VM these are set in Coolify's environment panel for the
# resource, not in a file: Coolify holds them and injects them at deploy time.
#
# This template is committed and must never gain a real value. A test enforces that
# (app/tests/test_deployment.py::test_the_committed_template_holds_no_credential).

# ---------------------------------------------------------------------------
# Studio secrets. Generate with: openssl rand -hex 32
# ---------------------------------------------------------------------------
# Shared between the web app and the worker; the worker rejects any other caller.
TATTOO_WORKER_TOKEN=

# Encrypts the media store at rest. CHANGING THIS MAKES EVERY STORED DESIGN AND PHOTO UNREADABLE.
# Generate once, back it up somewhere other than the VM, and treat rotating it as a data
# migration rather than a configuration change.
TATTOO_MEDIA_KEY=

# ---------------------------------------------------------------------------
# Model providers
# ---------------------------------------------------------------------------
# Artwork, reference analysis, moderation and the mockup finish. Required.
OPENAI_API_KEY=

# FLUX.2, used only for the generated skin plates (ADR-0009).
# Leave TATTOO_IMAGE_BACKEND=openai to run without a BFL account.
TATTOO_IMAGE_BACKEND=openai
BFL_API_KEY=
# The BFL cluster. EU by default. https://api.bfl.ai (global) routes round an EU incident; only a
# text prompt is sent, never a photograph.
TATTOO_BFL_BASE_URL=https://api.eu.bfl.ai

# The consultation agent runs inside the web app, so this is read there.
# Leave TATTOO_CONSULTATION_BACKEND empty to use the deterministic keyword path with no model calls.
TATTOO_CONSULTATION_BACKEND=claude
ANTHROPIC_API_KEY=

# The Sonnet scout that plans reference searches and judges the images found. Optional.
TATTOO_SCOUT_PLANNER=claude

# ---------------------------------------------------------------------------
# Accounts (TASK-0045). Without these the studio refuses everyone.
# ---------------------------------------------------------------------------
# The Supabase running on this host. The web container reaches it over the internal network;
# it never has to be published.
SUPABASE_URL=http://supabase-kong:8000

# The *anon* key, which is public by design. The service-role key is deliberately not used here:
# nothing in the studio needs to act as an administrator.
SUPABASE_ANON_KEY=

# The domain is not set here. It belongs to Coolify's own configuration (Domains for web, port
# 3000); declaring it in the compose file overwrites Coolify's copy on every read (TASK-0044).
